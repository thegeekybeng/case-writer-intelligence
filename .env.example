# Copy to .env and fill in all values before starting
# ────────────────────────────────────────────────────

# --- Admin credentials (build-time: baked into Vite bundle) ---
# TODO: Set your admin username and password
VITE_ADMIN_USER=change-me-admin-user
VITE_ADMIN_PASS=change-me-strong-password

# --- AI Inference Provider ---
# For local Ollama:
VITE_OPENAI_API_BASE=/api/v1
VITE_OPENAI_API_KEY=ollama
VITE_AI_MODEL=gemma4:e4b
OLLAMA_MODEL=gemma4:e4b

# For cloud providers (Groq, etc.):
# OLLAMA_API_KEY=your-api-key
# OLLAMA_API_BASE=https://api.groq.com/openai/v1
# OLLAMA_MODEL=llama-3.3-70b-versatile

# --- Server-side AI Proxy ---
# TODO: Set your Ollama / inference endpoint
OLLAMA_ENDPOINT=http://ollama-host:11434/v1/chat/completions
AI_MODEL=gemma4:e4b

# TODO: Generate with: openssl rand -hex 32
JWT_SECRET=generate-with-openssl-rand-hex-32
